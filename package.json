{
  "name": "cmc-mcp-server",
  "version": "2.3.0",
  "description": "CMC — Claude MCP Computer. run_command + confirmation + dashboard + session tokens.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "cmc:start": "tsx src/cli.ts start",
    "cmc:stop": "tsx src/cli.ts stop",
    "cmc:status": "tsx src/cli.ts status"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "claude",
    "run_command",
    "computer"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
